    <licence>AGPL-3.0-or-later</licence>
    <author mail="pawel@kuffel.io">Paweł Kuffel</author>
    <author>André Théo LAURET</author>
    <documentation>
        <admin>https://github.com/eldertek/nextcloud-webhooks#readme</admin>
    </documentation>
    <namespace>Webhooks</namespace>
    <category>integration</category>
    <category>tools</category>
    <category>workflow</category>
    <website>https://github.com/eldertek/nextcloud-webhooks</website>
    <bugs>https://github.com/eldertek/nextcloud-webhooks/issues</bugs>
    <repository>https://github.com/eldertek/nextcloud-webhooks</repository>
    <donation>https://patreon.com/eldertek</donation>
    <donation>https://github.com/sponsors/eldertek</donation>
    <screenshot>https://raw.githubusercontent.com/eldertek/nextcloud-webhooks/master/screenshots/admin.png</screenshot>
    <dependencies>
        <php min-version="8.2" max-version="8.5"/>
        <nextcloud min-version="28" max-version="35"/>
    </dependencies>

    <settings>
        <admin>OCA\Webhooks\Settings\Admin</admin>
    </settings>
</info>
